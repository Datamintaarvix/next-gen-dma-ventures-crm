# =========================================================================
# NEXT GEN DMA VENTURES CRM - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local to configure your live Supabase database
# =========================================================================

# 1. Supabase Project URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon Public Key (Browser Client Safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used by API routes and background migration scripts for administrative access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. Google Gemini Developer API Configuration (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Generated privately in Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
# Configurable Gemini Model ID (default: gemini-2.5-flash; can be gemini-2.0-flash, gemini-3.8-flash if supported)
GEMINI_MODEL=gemini-2.5-flash
