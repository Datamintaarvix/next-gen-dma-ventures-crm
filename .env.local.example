# =========================================================================
# NEXT GEN DMA VENTURES CRM - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local to configure your live Supabase database
# =========================================================================

# 1. Supabase Project URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon Public Key (Browser Client Safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used by API routes and background migration scripts for administrative access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
